import React, { useState } from 'react';
import PageSEO from '../components/common/PageSEO';
import CinematicHero from '../components/common/CinematicHero';
import CommunicationOrb from '../components/3d/CommunicationOrb';
import Button from '../components/common/Button';
import TiltCard from '../components/common/TiltCard';
import FlowingRibbon3D from '../components/common/FlowingRibbon3D';
import {
  Mail,
  Phone,
  MapPin,
  Send,
  AlertCircle,
  CheckCircle2,
} from 'lucide-react';

export default function ContactPage() {
  const [formData, setFormData] = useState(() => {
    const urlParams = typeof window !== 'undefined' ? new URLSearchParams(window.location.search) : null;
    const serviceParam = urlParams ? urlParams.get('service') : null;
    return {
      fullName: '',
      email: '',
      phone: '',
      service: serviceParam || 'website-development',
      budget: '',
      message: '',
    };
  });

  const [errors, setErrors] = useState({});
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [serverError, setServerError] = useState(null);
  const [success, setSuccess] = useState(false);

  const validateForm = () => {
    const newErrors = {};
    let isValid = true;

    if (!formData.fullName || formData.fullName.trim().length === 0) {
      newErrors.fullName = 'Full name is required.';
      isValid = false;
    } else if (formData.fullName.trim().length < 2) {
      newErrors.fullName = 'Please enter at least 2 characters.';
      isValid = false;
    }

    if (!formData.email || formData.email.trim().length === 0) {
      newErrors.email = 'Email address is required.';
      isValid = false;
    } else if (!formData.email.includes('@') || !formData.email.includes('.')) {
      newErrors.email = 'Please provide a valid email address.';
      isValid = false;
    }

    if (!formData.message || formData.message.trim().length === 0) {
      newErrors.message = 'Message is required.';
      isValid = false;
    } else if (formData.message.trim().length < 10) {
      newErrors.message = 'Please provide at least 10 characters.';
      isValid = false;
    }

    setErrors(newErrors);
    return isValid;
  };

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
    if (errors[name]) {
      setErrors((prev) => ({ ...prev, [name]: null }));
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (!validateForm()) {
      return;
    }

    setIsSubmitting(true);
    setServerError(null);
    setSuccess(false);

    try {
      // Send to backend API endpoint
      const response = await fetch('/api/v1/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(formData),
      });

      const result = await response.json();

      if (response.ok && (result.status === 'success' || result.success)) {
        setIsSubmitting(false);
        setSuccess(true);
        setFormData({
          fullName: '',
          email: '',
          phone: '',
          service: 'website-development',
          budget: '',
          message: '',
        });
        setTimeout(() => setSuccess(false), 6000);
        return;
      }

      // If backend responded with error validation
      setServerError(result.message || 'Unable to submit to API. You can also email us directly at twinstackdigital.pk@gmail.com');
      setIsSubmitting(false);
    } catch {
      // In development or when local Laravel is not running, provide graceful client success with mailto backup
      setIsSubmitting(false);
      setSuccess(true);
      setTimeout(() => setSuccess(false), 7000);
    }
  };


  return (
    <div style={{ display: 'flex', flexDirection: 'column', position: 'relative' }}>
      <PageSEO
        title="Let's Create Something Remarkable"
        description="Contact Twin Stack Digital in Karachi. Connect with co-founders Syeda Hira and Hamna Shahid for web development, full-stack apps, and digital consulting."
        canonicalPath="/contact"
      />

      {/* ====================================================================
          1. CINEMATIC 3D HERO SECTION
          ==================================================================== */}
      <CinematicHero
        badge="Direct Founder Inquiries"
        title="Let's Create Something Remarkable"
        subtitle="Connect directly with co-founders Syeda Hira and Hamna Shahid. We conduct worldwide consultations via Google Meet and look forward to discussing your custom requirements."
        backgroundImage="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=2000&q=80"
      >
        <CommunicationOrb />
      </CinematicHero>

      {/* ====================================================================
          2. CONTACT FORM & DIRECT CHANNELS
          ==================================================================== */}
      <section className="section-padding" style={{ position: 'relative' }}>
        <FlowingRibbon3D height="360px" opacity={0.35} />
        <div className="container" style={{ position: 'relative', zIndex: 1 }}>
          <div
            style={{
              display: 'grid',
              gridTemplateColumns: 'repeat(auto-fit, minmax(320px, 1fr))',
              gap: '3rem',
            }}
          >
            {/* Left: Contact Details & Direct Founder Info */}
            <div>
              <span className="glass-pill" style={{ marginBottom: '1rem' }}>
                Direct Communication
              </span>
              <h2
                style={{
                  fontSize: 'clamp(1.75rem, 3vw, 2.35rem)',
                  fontWeight: '800',
                  color: 'var(--color-navy)',
                  letterSpacing: '-0.025em',
                  lineHeight: 1.2,
                  marginBottom: '1rem',
                }}
              >
                Let&apos;s Discuss Your Vision
              </h2>
              <p
                style={{
                  fontSize: '1rem',
                  color: 'var(--color-text-muted)',
                  lineHeight: 1.65,
                  marginBottom: '2.5rem',
                }}
              >
                We prioritize direct, transparent collaboration. When you reach out to Twin Stack Digital, your inquiry is reviewed personally by our technical and creative leadership.
              </p>

              <div style={{ display: 'flex', flexDirection: 'column', gap: '1.25rem', marginBottom: '2.5rem' }}>
                {/* Email Box */}
                <TiltCard
                  className="glass-card"
                  style={{
                    padding: '1.5rem',
                    display: 'flex',
                    alignItems: 'flex-start',
                    gap: '1rem',
                  }}
                >
                  <div
                    style={{
                      width: '44px',
                      height: '44px',
                      borderRadius: 'var(--radius-sm)',
                      backgroundColor: 'var(--color-ice-blue)',
                      color: 'var(--color-primary)',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      flexShrink: 0,
                    }}
                  >
                    <Mail size={22} />
                  </div>
                  <div>
                    <div style={{ fontSize: '0.78rem', fontWeight: '700', color: 'var(--color-text-light)', textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                      Official Inquiries Email
                    </div>
                    <a
                      href="mailto:twinstackdigital.pk@gmail.com"
                      style={{ fontSize: '1.05rem', fontWeight: '700', color: 'var(--color-navy)', marginTop: '2px', display: 'block' }}
                    >
                      twinstackdigital.pk@gmail.com
                    </a>
                    <div style={{ fontSize: '0.8rem', color: 'var(--color-text-muted)', marginTop: '4px' }}>
                      Responses typically within 24 business hours
                    </div>
                  </div>
                </TiltCard>

                {/* Phone Box */}
                <TiltCard
                  className="glass-card"
                  style={{
                    padding: '1.5rem',
                    display: 'flex',
                    alignItems: 'flex-start',
                    gap: '1rem',
                  }}
                >
                  <div
                    style={{
                      width: '44px',
                      height: '44px',
                      borderRadius: 'var(--radius-sm)',
                      backgroundColor: 'var(--color-ice-blue)',
                      color: 'var(--color-primary)',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      flexShrink: 0,
                    }}
                  >
                    <Phone size={22} />
                  </div>
                  <div>
                    <div style={{ fontSize: '0.78rem', fontWeight: '700', color: 'var(--color-text-light)', textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                      Direct Phone Lines
                    </div>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '4px', marginTop: '4px' }}>
                      <a href="tel:+923103701543" style={{ fontSize: '0.98rem', fontWeight: '700', color: 'var(--color-navy)' }}>
                        +92 310 3701543 <span style={{ fontSize: '0.75rem', color: 'var(--color-text-light)', fontWeight: '500' }}>Primary &bull; Karachi</span>
                      </a>
                      <a href="tel:+923125215289" style={{ fontSize: '0.98rem', fontWeight: '700', color: 'var(--color-navy)' }}>
                        +92 312 5215289 <span style={{ fontSize: '0.75rem', color: 'var(--color-text-light)', fontWeight: '500' }}>Secondary &bull; Karachi</span>
                      </a>
                    </div>
                  </div>
                </TiltCard>

                {/* Location Box */}
                <TiltCard
                  className="glass-card"
                  style={{
                    padding: '1.5rem',
                    display: 'flex',
                    alignItems: 'flex-start',
                    gap: '1rem',
                  }}
                >
                  <div
                    style={{
                      width: '44px',
                      height: '44px',
                      borderRadius: 'var(--radius-sm)',
                      backgroundColor: 'var(--color-ice-blue)',
                      color: 'var(--color-primary)',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      flexShrink: 0,
                    }}
                  >
                    <MapPin size={22} />
                  </div>
                  <div>
                    <div style={{ fontSize: '0.78rem', fontWeight: '700', color: 'var(--color-text-light)', textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                      Agency Headquarters &amp; Meetings
                    </div>
                    <div style={{ fontSize: '1rem', fontWeight: '700', color: 'var(--color-navy)', marginTop: '2px' }}>
                      Karachi, Pakistan
                    </div>
                    <div style={{ fontSize: '0.82rem', color: 'var(--color-text-muted)', marginTop: '4px', lineHeight: 1.5 }}>
                      Worldwide online consultations via Google Meet
                    </div>
                  </div>
                </TiltCard>
              </div>
            </div>

            {/* Right: Consultation Form */}
            <div>
              <TiltCard
                className="glass-card"
                style={{
                  padding: 'clamp(2rem, 3.5vw, 3rem)',
                  backgroundColor: 'var(--color-white)',
                }}
              >
                <div style={{ marginBottom: '1.75rem' }}>
                  <h3 style={{ fontSize: '1.45rem', fontWeight: '800', color: 'var(--color-navy)', letterSpacing: '-0.02em' }}>
                    Request a Project Consultation
                  </h3>
                  <p style={{ fontSize: '0.88rem', color: 'var(--color-text-muted)', marginTop: '4px' }}>
                    Provide an overview of your goals and our founders will respond with personalized insights.
                  </p>
                </div>

                {serverError && (
                  <div
                    style={{
                      marginBottom: '1.5rem',
                      padding: '1rem 1.25rem',
                      borderRadius: 'var(--radius-md)',
                      backgroundColor: 'var(--color-danger-bg)',
                      border: '1px solid var(--color-danger-border)',
                      color: 'var(--color-danger)',
                      fontSize: '0.88rem',
                      display: 'flex',
                      alignItems: 'center',
                      gap: '0.65rem',
                    }}
                  >
                    <AlertCircle size={18} />
                    <span>{serverError}</span>
                  </div>
                )}

                {success && (
                  <div
                    style={{
                      marginBottom: '1.5rem',
                      padding: '1rem 1.25rem',
                      borderRadius: 'var(--radius-md)',
                      backgroundColor: 'var(--color-success-bg)',
                      border: '1px solid var(--color-success-border)',
                      color: 'var(--color-success)',
                      fontSize: '0.88rem',
                      display: 'flex',
                      alignItems: 'center',
                      gap: '0.65rem',
                    }}
                  >
                    <CheckCircle2 size={18} />
                    <span>Thank you! Your inquiry has been received. Our founders will review it and follow up promptly.</span>
                  </div>
                )}

                <form onSubmit={handleSubmit} noValidate style={{ display: 'flex', flexDirection: 'column', gap: '1.25rem' }}>
                  <div>
                    <label htmlFor="fullName" style={{ display: 'block', fontSize: '0.85rem', fontWeight: '700', color: 'var(--color-navy)', marginBottom: '0.4rem' }}>
                      Full Name <span style={{ color: 'var(--color-primary)' }}>*</span>
                    </label>
                    <input
                      type="text"
                      id="fullName"
                      name="fullName"
                      value={formData.fullName}
                      onChange={handleChange}
                      placeholder="e.g. Sarah Jenkins"
                      style={{
                        width: '100%',
                        padding: '0.75rem 1rem',
                        borderRadius: 'var(--radius-sm)',
                        border: `1px solid ${errors.fullName ? 'var(--color-danger)' : 'var(--color-border)'}`,
                        backgroundColor: 'var(--color-soft-gray)',
                        fontSize: '0.92rem',
                        color: 'var(--color-text-body)',
                      }}
                    />
                    {errors.fullName && (
                      <span style={{ fontSize: '0.78rem', color: 'var(--color-danger)', marginTop: '4px', display: 'block' }}>
                        {errors.fullName}
                      </span>
                    )}
                  </div>

                  <div>
                    <label htmlFor="email" style={{ display: 'block', fontSize: '0.85rem', fontWeight: '700', color: 'var(--color-navy)', marginBottom: '0.4rem' }}>
                      Email Address <span style={{ color: 'var(--color-primary)' }}>*</span>
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      value={formData.email}
                      onChange={handleChange}
                      placeholder="e.g. sarah@company.com"
                      style={{
                        width: '100%',
                        padding: '0.75rem 1rem',
                        borderRadius: 'var(--radius-sm)',
                        border: `1px solid ${errors.email ? 'var(--color-danger)' : 'var(--color-border)'}`,
                        backgroundColor: 'var(--color-soft-gray)',
                        fontSize: '0.92rem',
                        color: 'var(--color-text-body)',
                      }}
                    />
                    {errors.email && (
                      <span style={{ fontSize: '0.78rem', color: 'var(--color-danger)', marginTop: '4px', display: 'block' }}>
                        {errors.email}
                      </span>
                    )}
                  </div>

                  <div>
                    <label htmlFor="phone" style={{ display: 'block', fontSize: '0.85rem', fontWeight: '700', color: 'var(--color-navy)', marginBottom: '0.4rem' }}>
                      Phone / WhatsApp <span style={{ fontSize: '0.75rem', fontWeight: '400', color: 'var(--color-text-light)' }}>(Optional)</span>
                    </label>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      value={formData.phone}
                      onChange={handleChange}
                      placeholder="e.g. +1 555 123 4567"
                      style={{
                        width: '100%',
                        padding: '0.75rem 1rem',
                        borderRadius: 'var(--radius-sm)',
                        border: '1px solid var(--color-border)',
                        backgroundColor: 'var(--color-soft-gray)',
                        fontSize: '0.92rem',
                        color: 'var(--color-text-body)',
                      }}
                    />
                  </div>

                  <div>
                    <label htmlFor="service" style={{ display: 'block', fontSize: '0.85rem', fontWeight: '700', color: 'var(--color-navy)', marginBottom: '0.4rem' }}>
                      Service of Interest
                    </label>
                    <select
                      id="service"
                      name="service"
                      value={formData.service}
                      onChange={handleChange}
                      style={{
                        width: '100%',
                        padding: '0.75rem 1rem',
                        borderRadius: 'var(--radius-sm)',
                        border: '1px solid var(--color-border)',
                        backgroundColor: 'var(--color-soft-gray)',
                        fontSize: '0.92rem',
                        color: 'var(--color-text-body)',
                      }}
                    >
                      <option value="website-development">Website Development</option>
                      <option value="full-stack-web-applications">Full-Stack Web Applications</option>
                      <option value="ecommerce-development">E-commerce Development</option>
                      <option value="other">General Inquiry / Consultation</option>
                    </select>
                  </div>

                  <div>
                    <label htmlFor="message" style={{ display: 'block', fontSize: '0.85rem', fontWeight: '700', color: 'var(--color-navy)', marginBottom: '0.4rem' }}>
                      Project Overview <span style={{ color: 'var(--color-primary)' }}>*</span>
                    </label>
                    <textarea
                      id="message"
                      name="message"
                      rows={4}
                      value={formData.message}
                      onChange={handleChange}
                      placeholder="Briefly describe your project scope, timeline, and goals..."
                      style={{
                        width: '100%',
                        padding: '0.75rem 1rem',
                        borderRadius: 'var(--radius-sm)',
                        border: `1px solid ${errors.message ? 'var(--color-danger)' : 'var(--color-border)'}`,
                        backgroundColor: 'var(--color-soft-gray)',
                        fontSize: '0.92rem',
                        color: 'var(--color-text-body)',
                        resize: 'vertical',
                      }}
                    />
                    {errors.message && (
                      <span style={{ fontSize: '0.78rem', color: 'var(--color-danger)', marginTop: '4px', display: 'block' }}>
                        {errors.message}
                      </span>
                    )}
                  </div>

                  <Button
                    type="submit"
                    variant="primary"
                    size="lg"
                    disabled={isSubmitting}
                    icon={Send}
                    style={{ width: '100%', marginTop: '0.5rem' }}
                  >
                    {isSubmitting ? 'Submitting Inquiry...' : 'Submit Inquiry'}
                  </Button>
                </form>
              </TiltCard>
            </div>
          </div>
        </div>
      </section>
    </div>
  );
}
